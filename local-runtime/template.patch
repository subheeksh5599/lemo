diff --git a/node/src/service.rs b/node/src/service.rs
index dd932b2..21016b9 100644
--- a/node/src/service.rs
+++ b/node/src/service.rs
@@ -23,6 +23,18 @@ type FullSelectChain = sc_consensus::LongestChain<FullBackend, Block>;
 /// imported and generated.
 const GRANDPA_JUSTIFICATION_PERIOD: u32 = 512;
 
+/// `LEMO_GRANDPA_JUSTIFICATION_PERIOD` overrides the period. The local
+/// end-to-end run sets it to 1 so every GRANDPA commit target keeps its
+/// justification and `chain_getBlock` returns it (engine id `FRNK`); the
+/// default stays 512.
+fn grandpa_justification_period() -> u32 {
+	std::env::var("LEMO_GRANDPA_JUSTIFICATION_PERIOD")
+		.ok()
+		.and_then(|v| v.parse::<u32>().ok())
+		.filter(|v| *v > 0)
+		.unwrap_or(GRANDPA_JUSTIFICATION_PERIOD)
+}
+
 pub type Service = sc_service::PartialComponents<
 	FullClient,
 	FullBackend,
@@ -77,7 +89,7 @@ pub fn new_partial(config: &Configuration) -> Result<Service, ServiceError> {
 
