# Copy to .env.local and fill in. Never commit the filled file.
# This is the deployment half, not a website setting.

DEPLOY_CONFIRM=no
RPC_URL=https://test-evm-rpc-v3.portaldot.dev

# The EVM deployer. Fund it with testnet POT before setting DEPLOY_CONFIRM=yes.
PRIVATE_KEY=

# 2-of-3 independent root attesters. Set THRESHOLD=0 to use the single
# attested feed with ATTESTER instead.
THRESHOLD=2
ATTESTER_1=
ATTESTER_2=
ATTESTER_3=
ATTESTER=

TITLE_ID=
NATIVE_ASSET=
BACKING=
OWNER=
IDENTITY_HASH=
VESTING_HASH=
PERMISSIONS_HASH=
REVISION=1
TITLE_COMMITMENT=
TOKEN_NAME=LEMO Title 1
TOKEN_SYMBOL=LT1
