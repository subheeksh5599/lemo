# Copy this file to .env.local and fill only what applies.
#
# The flow console reads these three addresses at build time. Leave them empty
# until the contracts are deployed; the page renders the missing variable name
# instead of inventing an address.
NEXT_PUBLIC_LEMO_GATE=
NEXT_PUBLIC_LEMO_VERIFIER=
NEXT_PUBLIC_LEMO_FEED=

# Optional: a block explorer URL for transaction links.
NEXT_PUBLIC_EVM_EXPLORER=

# React Bits Pro registry license, only needed when adding a Pro component.
# https://pro.reactbits.dev/docs/installation
REACTBITS_LICENSE_KEY=
